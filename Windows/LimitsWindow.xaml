<Window x:Class="RigolWidget.Windows.LimitsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Output Limits"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="LimitInput" TargetType="TextBox">
            <Setter Property="Width" Value="70"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="#DDE1E6"/>
            <Setter Property="Background" Value="#0F1013"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="CaretBrush" Value="#F2A900"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7C828A"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,14,0"/>
        </Style>
    </Window.Resources>

    <Border Background="#1B1C20" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <!-- Title bar -->
            <Border Background="#111216" CornerRadius="6,6,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="38">
                    <TextBlock Text="Output Limits" Foreground="#F2A900" FontWeight="Bold" FontSize="15"
                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <Button Content="✕" Click="Cancel_Click" Width="38" Height="38" HorizontalAlignment="Right"
                            Foreground="#C8CCD2" FontSize="14" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                </Grid>
            </Border>

            <TextBlock Margin="14,12,14,4" Foreground="#B9BFC6" FontSize="12" TextWrapping="Wrap"
                       Text="Setpoints above these values are refused, from the widget and from AI (MCP). The output also cannot be turned on while a setpoint is above its limit. Leave a box empty for no limit."/>
            <TextBlock Margin="14,0,14,10" Foreground="#7C828A" FontSize="11" TextWrapping="Wrap"
                       Text="AI clients cannot change these limits."/>

            <!-- One row per channel; rows of channels the model lacks are hidden in code. -->
            <StackPanel x:Name="Rows" Margin="14,0,14,4">
                <StackPanel x:Name="Row1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="CH1" Width="40" FontWeight="ExtraBold" FontSize="14" Foreground="#35C24A" VerticalAlignment="Center"/>
                    <TextBox x:Name="V1" Style="{StaticResource LimitInput}"/>
                    <TextBlock x:Name="V1Hint" Text="V" Style="{StaticResource Hint}"/>
                    <TextBox x:Name="A1" Style="{StaticResource LimitInput}"/>
                    <TextBlock x:Name="A1Hint" Text="A" Style="{StaticResource Hint}"/>
                </StackPanel>
                <StackPanel x:Name="Row2" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="CH2" Width="40" FontWeight="ExtraBold" FontSize="14" Foreground="#22BCD4" VerticalAlignment="Center"/>
                    <TextBox x:Name="V2" Style="{StaticResource LimitInput}"/>
                    <TextBlock x:Name="V2Hint" Text="V" Style="{StaticResource Hint}"/>
                    <TextBox x:Name="A2" Style="{StaticResource LimitInput}"/>
                    <TextBlock x:Name="A2Hint" Text="A" Style="{StaticResource Hint}"/>
                </StackPanel>
                <StackPanel x:Name="Row3" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="CH3" Width="40" FontWeight="ExtraBold" FontSize="14" Foreground="#E6A23C" VerticalAlignment="Center"/>
                    <TextBox x:Name="V3" Style="{StaticResource LimitInput}"/>
                    <TextBlock x:Name="V3Hint" Text="V" Style="{StaticResource Hint}"/>
                    <TextBox x:Name="A3" Style="{StaticResource LimitInput}"/>
                    <TextBlock x:Name="A3Hint" Text="A" Style="{StaticResource Hint}"/>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Margin="14,0,14,6" Foreground="#FF5A5A" FontSize="12"
                       TextWrapping="Wrap" Visibility="Collapsed"/>

            <!-- Buttons -->
            <Grid Margin="14,6,14,14">
                <Button Content="Clear All" Click="ClearAll_Click" HorizontalAlignment="Left"
                        Padding="14,7" Cursor="Hand" Background="#2A2D34" Foreground="#DDE1E6"
                        BorderThickness="0" FontSize="13"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="Cancel_Click" IsCancel="True"
                            Padding="16,7" Margin="0,0,8,0" Cursor="Hand"
                            Background="#2A2D34" Foreground="#DDE1E6" BorderThickness="0" FontSize="13"/>
                    <Button Content="Save" Click="Save_Click" IsDefault="True"
                            Padding="22,7" Cursor="Hand" Background="#F2A900" Foreground="#1A1A1A"
                            BorderThickness="0" FontWeight="SemiBold" FontSize="13"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
